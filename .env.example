# Copy to .env (never commit it). docker compose refuses to start while a required value is empty.

# Image tag; "latest" follows the newest release. Pin a version in production.
DPDPKIT_VERSION=latest

# Password of the database user "dpdpkit".
POSTGRES_PASSWORD=

# Long random string used to sign end-user and admin tokens, for example: openssl rand -hex 32
DPDPKIT_SIGNING_KEY=

# SHA-256 hash of your backend's API key (comma-separated for several). Make a key and its hash with:
#   docker run --rm ghcr.io/dpdpkit-dev/server new-api-key
# Give the key (dpk_...) to your backend; only the hash goes here.
DPDPKIT_API_KEY_HASHES=

# Optional: admin password hash for POST /admin/login, made with
#   docker run --rm -it ghcr.io/dpdpkit-dev/server hash-password
# Single-quote it, because it contains "$".
DPDPKIT_ADMIN_PASSWORD_HASH=

# Shared secret used to sign webhooks sent to your app (the app verifies X-DPDPKit-Signature with it).
APP_WEBHOOK_SECRET=
